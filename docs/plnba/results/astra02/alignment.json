        },
        {
          "source_start": 14,
          "text": "赫尔特分给巴恩斯，再送到底角穆雷。",
          "start": 95.0,
          "end": 97.8848125,
          "audio": "media/P06_3.wav",
          "source_interval": [
            14,
            16.30785
          ]
        },
        {
          "source_start": 16.4,
          "text": "穆雷晃开防守，三分不中，格林收下篮板。",
          "start": 98.0,
          "end": 101.4646875,
          "audio": "media/P06_4.wav",
