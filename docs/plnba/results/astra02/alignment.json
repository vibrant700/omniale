    {
      "id": "P04",
      "title": "抢断直冲篮下",
      "source_duration": 15,
      "speed": 0.8,
      "cues": [
        {
          "source_start": 1,
          "text": "福克斯带过半场，维金斯贴身盯防。",
          "start": 45.0,
          "end": 48.35852083333333,
          "audio": "media/P04_0.wav",
          "source_interval": [
            1,
            3.686816666666667
          ]
        },
        {
          "source_start": 6.3,
          "text": "萨博尼斯上来掩护，福克斯准备突破。",
          "start": 51.625,
          "end": 55.17127083333333,
          "audio": "media/P04_1.wav",
          "source_interval": [
            6.3,
            9.137016666666668
          ]
        },
        {
          "source_start": 9.4,
          "text": "维金斯把球断下，自己加速反击。",
          "start": 55.5,
          "end": 58.865,
          "audio": "media/P04_2.wav",
          "source_interval": [
            9.4,
            12.092
          ]
        },
        {
          "source_start": 12.6,
          "text": "顶着追防上篮，把球打进。",
          "start": 59.5,
          "end": 62.15529166666666,
          "audio": "media/P04_3.wav",
          "source_interval": [
            12.6,
            14.724233333333334
