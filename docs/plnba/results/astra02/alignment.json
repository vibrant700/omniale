    {
      "id": "P06",
      "title": "断球后的底角机会",
      "source_duration": 20,
      "speed": 0.8,
      "cues": [
        {
          "source_start": 0.5,
          "text": "勇士推进，普尔和汤普森先后参与传导。",
          "start": 78.125,
          "end": 82.46579166666666,
          "audio": "media/P06_0.wav",
          "source_interval": [
            0.5,
            3.972633333333334
          ]
        },
        {
          "source_start": 7,
          "text": "球来到德雷蒙德·格林手里。",
          "start": 86.25,
          "end": 88.7050625,
          "audio": "media/P06_1.wav",
          "source_interval": [
            7,
            8.96405
          ]
        },
        {
          "source_start": 10.5,
          "text": "传球被赫尔特截下，国王立刻反击。",
          "start": 90.625,
          "end": 94.25458333333333,
          "audio": "media/P06_2.wav",
          "source_interval": [
            10.5,
            13.403666666666666
