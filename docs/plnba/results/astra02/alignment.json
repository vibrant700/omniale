    {
      "id": "P03",
      "title": "传完球，再空切",
      "source_duration": 14,
      "speed": 0.8,
      "cues": [
        {
          "source_start": 0.2,
          "text": "卢尼在高位，手递手交给普尔。",
          "start": 26.5,
          "end": 29.629395833333334,
          "audio": "media/P03_0.wav",
          "source_interval": [
            0.2,
            2.703516666666667
          ]
        },
        {
          "source_start": 4,
          "text": "普尔和库里来回配合，球又回到普尔手上。",
          "start": 31.25,
          "end": 35.330104166666665,
          "audio": "media/P03_1.wav",
          "source_interval": [
            4,
            7.264083333333334
          ]
        },
        {
          "source_start": 9,
          "text": "库里没有停在外线，空切接回传。",
          "start": 37.5,
          "end": 40.36364583333334,
          "audio": "media/P03_2.wav",
          "source_interval": [
            9,
            11.290916666666668
          ]
        },
        {
          "source_start": 11.5,
          "text": "篮下打进，关键是传球后的移动。",
          "start": 40.625,
          "end": 43.502604166666664,
          "audio": "media/P03_3.wav",
          "source_interval": [
