              "start_sec": 0,
              "end_sec": 9
            }
          ]
        },
        {
          "id": "P04_02",
          "text": "伸手断球，维金斯自己带球反击。",
          "audio_start_sec": 57.1,
          "audio_end_sec": 60.016375000000004,
          "source_evidence": [
            {
              "start_sec": 9,
              "end_sec": 12
            }
          ]
        },
        {
          "id": "P04_03",
          "text": "篮下没有急着出手，连续虚晃后打进。",
          "audio_start_sec": 60.85,
          "audio_end_sec": 64.33739583333333,
          "source_evidence": [
            {
              "start_sec": 12,
              "end_sec": 15
            }
