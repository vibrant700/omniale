          "text": "卢尼高位接应，再手递手给库里。",
          "audio_start_sec": 20.6,
          "audio_end_sec": 23.584541666666667,
          "source_evidence": [
            {
              "start_sec": 4,
              "end_sec": 6
            }
          ]
        },
        {
          "id": "P02_03",
          "text": "接球直接拔起，三分命中！",
          "audio_start_sec": 23.8,
          "audio_end_sec": 26.04072916666667,
          "source_evidence": [
            {
              "start_sec": 6,
              "end_sec": 9
            }
          ]
        }
      ],
      "segments": [
        {
