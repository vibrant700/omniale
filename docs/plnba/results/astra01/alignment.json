          "audio_start_sec": 75.35,
          "audio_end_sec": 78.61241666666666,
          "source_evidence": [
            {
              "start_sec": 8,
              "end_sec": 10
            }
          ]
        },
        {
          "id": "P05_03",
          "text": "补篮也没中，最后卢尼收下篮板。",
          "audio_start_sec": 78.83333333333333,
          "audio_end_sec": 81.85193749999999,
          "source_evidence": [
